---
import type { CollectionEntry } from 'astro:content';
import Hazard from './Hazard.astro';
import Relic from './Relic.astro';
import { formatPrice, url } from '../lib/catalog';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const { name, price, hazardLevel, glyph, tagline, inStock } = product.data;
---

<article class="relic-card flex h-full flex-col p-4" data-card>
  <a href={url(`products/${product.id}/`)} class="group flex flex-1 flex-col">
    <Relic id={product.id} glyph={glyph} hazard={hazardLevel} />
    <h3 class="mt-3 font-display text-xl leading-tight text-sand uppercase group-hover:text-spice">{name}</h3>
    <p class="mt-1 flex-1 text-sm text-dust">{tagline}</p>
  </a>

  <div class="mt-3 text-sm"><Hazard level={hazardLevel} /></div>

  <div class="mt-3 flex items-center justify-between gap-2">
    <span class="glow font-term text-3xl text-spice">{formatPrice(price)}</span>
    {
      inStock ? (
        <button class="btn text-xs" data-add-to-cart data-slug={product.id} data-name={name} data-price={price}>
          В трюм
        </button>
      ) : (
        <span class="text-xs text-blood">СБЕЖАЛ СО СКЛАДА</span>
      )
    }
  </div>
</article>
