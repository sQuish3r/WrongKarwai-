---
import type { CollectionEntry } from 'astro:content';
import Hazard from './Hazard.astro';
import { formatPrice, url } from '../lib/catalog';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const { name, price, hazardLevel, glyph, tagline, inStock } = product.data;

// Детерминированные «капли» — у каждой карточки своя форма потёков
const seed = [...product.id].reduce((s, c) => s + c.charCodeAt(0), 0);
const drips = Array.from({ length: 3 }, (_, i) => {
  const r = (seed * (i + 7) * 9301 + 49297) % 233280;
  return {
    left: 10 + ((r % 80) | 0),
    h: 14 + (r % 30),
    d: 3 + (r % 5),
    delay: (r % 40) / 10,
  };
});
---

<article class="slime-card flex flex-col p-4">
  <div class="drip" aria-hidden="true">
    {
      drips.map((d) => (
        <span style={`left:${d.left}%;--h:${d.h}px;--d:${d.d}s;--delay:${d.delay}s`} />
      ))
    }
  </div>

  <a href={url(`products/${product.id}/`)} class="group flex flex-1 flex-col">
    <div class="glyph mb-3 text-center text-6xl" aria-hidden="true">{glyph}</div>
    <h3 class="glow font-term text-2xl leading-tight group-hover:underline">{name}</h3>
    <p class="mt-1 flex-1 text-sm text-phosphor-dim">{tagline}</p>
  </a>

  <div class="mt-3 text-sm"><Hazard level={hazardLevel} /></div>

  <div class="mt-3 flex items-center justify-between gap-2">
    <span class="font-term text-2xl text-acid">{formatPrice(price)}</span>
    {
      inStock ? (
        <button
          class="btn text-xs"
          data-add-to-cart
          data-slug={product.id}
          data-name={name}
          data-price={price}
        >
          В трюм
        </button>
      ) : (
        <span class="text-xs text-blood">СБЕЖАЛ СО СКЛАДА</span>
      )
    }
  </div>
</article>
