---
import '../styles/global.css';
import { url } from '../lib/catalog';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Halcyon-Drax Bioproducts — официальный поставщик всего, что не стоило привозить на Землю.' } = Astro.props;
const fullTitle = title ? `${title} // HALCYON-DRAX` : 'HALCYON-DRAX BIOPRODUCTS';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Russo+One&family=Share+Tech+Mono&family=VT323&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
  </head>
  <body class="crt">
    <div class="mx-auto max-w-6xl px-4 py-6">
      <header class="mb-8 border-b border-dust pb-4">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <a href={url()} class="block">
            <p class="holo-glow text-xs tracking-[0.3em] text-holo">◬ СИНОД ВЫЧИСЛИТЕЛЯ // ТОРГОВЫЙ АЛТАРЬ v2.1.79</p>
            <h1 class="glow font-display text-3xl leading-none text-spice sm:text-5xl">HALCYON-DRAX</h1>
            <p class="font-display text-sm tracking-[0.5em] text-sand">BIOPRODUCTS</p>
            <p class="text-sm text-dust">«Строим лучшие миры. Из того, что нашли.»</p>
          </a>
          <nav class="flex items-center gap-4 font-term text-2xl">
            <a href={url()} class="hover:glow">[КАТАЛОГ]</a>
            <a href={url('cart/')} class="hover:glow">
              [ТРЮМ: <span class="inline-block" data-cart-count>0</span>]
            </a>
          </nav>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer class="mt-16 border-t border-dust pt-4 text-xs text-dust">
        <p>© 2179 Halcyon-Drax Bioproducts. Все товары вымышлены. Экипаж — расходный материал.</p>
        <p>Возврат товара невозможен: товар обычно возвращается сам.</p>
        <p>Вычислитель видит каждую покупку. Вычислитель прощает. За отдельную плату.</p>
      </footer>
    </div>

    <script>
      import { onCartChange, cartCount } from '../scripts/cart';
      import { initRelics } from '../scripts/relics';
      initRelics();
      onCartChange((items) => {
        document.querySelectorAll('[data-cart-count]').forEach((el) => {
          el.textContent = String(cartCount(items));
        });
      });
    </script>
  </body>
</html>
